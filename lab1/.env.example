# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# Langfuse Cloud: https://cloud.langfuse.com → Project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU-регион: https://cloud.langfuse.com, US-регион: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Локальный сервер Ollama
OLLAMA_HOST=http://localhost:11434
